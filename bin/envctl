#!/usr/bin/env python3
"""envctl — dotenv editor with automatic backup via bakctl.

Default target: ~/cc/.env (override with --file or $ENVCTL_FILE).

Operations:
  set KEY [VALUE]   — set or upsert; idempotent (no backup if already that value).
                      Omit VALUE to read it from stdin (`op read … | envctl set KEY`)
                      so the secret never appears in argv / shell history.
  unset KEY         — remove KEY=... line
  get KEY           — print value to stdout; exit 1 if missing
  list              — print keys, one per line (values NOT printed)
  export            — print `export KEY=<shell-quoted>` lines (decrypt-on-use);
                      use as: source <(envctl --file ~/cc/.env.enc export)
  exec -- CMD ...   — run CMD with the dotenv injected into its environment
                      (envctl passes decrypted values in memory)
  history           — proxy to `bakctl history`
  restore TS        — proxy to `bakctl restore`

Encrypted mode: if the target path ends in `.enc`,
envctl transparently decrypts for reads and re-encrypts for writes via SOPS+age.
envctl uses subprocess pipes for plaintext. bakctl snapshots the
already-encrypted `.enc` file → backups are encrypted-by-construction. Non-.enc
targets use the plaintext storage path. See the documented validation changes.

Backups are produced by sibling tool `bakctl` (default: ./bakctl next to this
script). Tokens are never echoed except via `get`/`export`/`exec`.
"""
from __future__ import annotations

import argparse
import json
import fcntl
import re
from contextlib import contextmanager
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

VERSION = "0.1.0"

BAKCTL = str(Path(__file__).resolve().with_name("bakctl"))
SOPS = os.environ.get("ENVCTL_SOPS_BIN") or shutil.which("sops") or "/opt/homebrew/bin/sops"
AGE_KEY_FILE = os.environ.get(
    "SOPS_AGE_KEY_FILE", str(Path("~/.config/sops/age/keys.txt").expanduser())
)


def _run_bakctl(*args: str) -> int:
    return subprocess.call([BAKCTL, *args])


def _is_enc(path: Path) -> bool:
    return path.name.endswith(".enc")


def _sops_env() -> dict:
    env = dict(os.environ)
    env["SOPS_AGE_KEY_FILE"] = AGE_KEY_FILE
    return env


def _sops_config(path: Path) -> list[str]:
    cfg = path.parent / ".sops.yaml"
    return ["--config", str(cfg)] if cfg.is_file() else []


def _sops_decrypt(path: Path) -> list[str]:
    """Decrypt an encrypted dotenv to in-memory lines. Plaintext never on disk."""
    if not path.is_file():
        return []
    out = subprocess.run(
        [SOPS, *_sops_config(path), "-d",
         "--input-type", "dotenv", "--output-type", "dotenv", str(path)],
        check=True, capture_output=True, text=True, env=_sops_env(),
    ).stdout
    return out.splitlines(keepends=False)


def _sops_encrypt_write(path: Path, lines: list[str]) -> None:
    """Re-encrypt lines and atomically replace `path`. Plaintext only in a pipe."""
    text = "\n".join(lines) + "\n" if lines else "# envctl: empty\n"
    enc = subprocess.run(
        [SOPS, *_sops_config(path), "-e",
         "--input-type", "dotenv", "--output-type", "dotenv",
         "--filename-override", str(path), "/dev/stdin"],
        check=True, capture_output=True, text=True, input=text, env=_sops_env(),
    ).stdout
    # Refuse a recipient change that would lock the current identity out.
    recovered = subprocess.run(
        [SOPS, "-d", "--input-type", "dotenv", "--output-type", "dotenv", "/dev/stdin"],
        check=True, capture_output=True, text=True, input=enc, env=_sops_env(),
    ).stdout
    if recovered.splitlines() != text.splitlines():
        raise ValueError("encrypted round-trip mismatch")
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(enc)
        os.chmod(tmp, 0o600)
        if path.is_file():
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def _load(path: Path) -> list[str]:
    if _is_enc(path):
        return _sops_decrypt(path)
    if not path.is_file():
        return []
    return path.read_text(encoding="utf-8").splitlines(keepends=False)


def _find(lines: list[str], key: str) -> int | None:
    pfx = f"{key}="
    for i, ln in enumerate(lines):
        if ln.startswith(pfx):
            return i
    return None


def _write(path: Path, lines: list[str]) -> None:
    if _is_enc(path):
        _sops_encrypt_write(path, lines)
        return
    text = "\n".join(lines) + "\n" if lines else ""
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if path.is_file():
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def _backup(path: Path) -> str:
    """Run bakctl backup; return the backup path (stdout).

    For .enc targets this snapshots the already-encrypted file → backups are
    encrypted-by-construction (no plaintext .bak proliferation).
    """
    if not path.is_file():
        return ""
    out = subprocess.run([BAKCTL, "backup", str(path)], check=True,
                         capture_output=True, text=True).stdout.strip()
    return out


def _kv(lines: list[str]):
    for ln in lines:
        s = ln.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
            yield k, v


def cmd_set(args) -> int:
    path = Path(args.file).expanduser()
    value = args.value
    if value is None:  # read from stdin so the secret never touches argv (`producer | envctl set KEY`)
        value = sys.stdin.read()
        if value.endswith("\n"):
            value = value[:-1]
    if any(c in value for c in "\r\n\0"):
        raise ValueError("values must be a single line without NUL")
    lines = _load(path)
    idx = _find(lines, args.key)
    new_line = f"{args.key}={value}"
    if idx is not None and lines[idx] == new_line:
        print(f"no-op: {args.key} already has that value", file=sys.stderr)
        return 0
    bak = _backup(path)
    if idx is None:
        lines.append(new_line)
    else:
        lines[idx] = new_line
    _write(path, lines)
    print(f"set {args.key} (backup: {Path(bak).name if bak else 'none'})", file=sys.stderr)
    return 0


def cmd_unset(args) -> int:
    path = Path(args.file).expanduser()
    lines = _load(path)
    idx = _find(lines, args.key)
    if idx is None:
        print(f"no-op: {args.key} not present", file=sys.stderr)
        return 0
    bak = _backup(path)
    del lines[idx]
    _write(path, lines)
    print(f"unset {args.key} (backup: {Path(bak).name if bak else 'none'})", file=sys.stderr)
    return 0


def cmd_get(args) -> int:
    lines = _load(Path(args.file).expanduser())
    idx = _find(lines, args.key)
    if idx is None:
        return 1
    print(lines[idx].split("=", 1)[1])
    return 0


def cmd_list(args) -> int:
    for k, _ in _kv(_load(Path(args.file).expanduser())):
        print(k)
    return 0


def cmd_export(args) -> int:
    for k, v in _kv(_load(Path(args.file).expanduser())):
        print(f"export {k}={shlex.quote(v)}")
    return 0


def cmd_exec(args) -> int:
    cmd = args.cmd
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        print("exec: no command given", file=sys.stderr)
        return 2
    env = dict(os.environ)
    for k, v in _kv(_load(Path(args.file).expanduser())):
        env[k] = v
    os.execvpe(cmd[0], cmd, env)
    return 127  # unreachable on success


def cmd_history(args) -> int:
    return _run_bakctl("history", str(Path(args.file).expanduser()))


def cmd_restore(args) -> int:
    return _run_bakctl("restore", str(Path(args.file).expanduser()), args.ts)


@contextmanager
def _mutation_lock(path: Path):
    # Keep the lock inode: unlinking it lets waiters lock a different inode.
    lock = path.with_name(path.name + ".envctl.lock")
    fd = os.open(lock, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if path.is_symlink():
            raise ValueError("symlink targets are not supported for mutations")
        if path.exists() and (not path.is_file() or path.stat().st_nlink != 1):
            raise ValueError("mutation requires a regular file with one link")
        yield
    finally:
        os.close(fd)


def _version() -> str:
    metadata = Path(__file__).resolve().parents[1] / "RELEASE.json"
    commit = json.loads(metadata.read_text())["commit"] if metadata.is_file() else "development"
    return f"envctl {VERSION} (commit {commit})"


def main() -> int:
    default_file = os.environ.get("ENVCTL_FILE", "~/cc/.env")
    p = argparse.ArgumentParser(prog="envctl")
    p.add_argument("--version", action="version",
                   version=_version())
    p.add_argument("--file", default=default_file, help=f"target dotenv (default {default_file})")
    sub = p.add_subparsers(dest="op", required=True)

    sp = sub.add_parser("set"); sp.add_argument("key"); sp.add_argument("value", nargs="?", help="value; if omitted, read from stdin (keeps secrets off argv)"); sp.set_defaults(fn=cmd_set)
    sp = sub.add_parser("unset"); sp.add_argument("key"); sp.set_defaults(fn=cmd_unset)
    sp = sub.add_parser("get"); sp.add_argument("key"); sp.set_defaults(fn=cmd_get)
    sp = sub.add_parser("list"); sp.set_defaults(fn=cmd_list)
    sp = sub.add_parser("export"); sp.set_defaults(fn=cmd_export)
    sp = sub.add_parser("exec"); sp.add_argument("cmd", nargs=argparse.REMAINDER); sp.set_defaults(fn=cmd_exec)
    sp = sub.add_parser("history"); sp.set_defaults(fn=cmd_history)
    sp = sub.add_parser("restore"); sp.add_argument("ts"); sp.set_defaults(fn=cmd_restore)

    args = p.parse_args()
    if hasattr(args, "key") and not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", args.key):
        p.error("key must match [A-Za-z_][A-Za-z0-9_]*")
    try:
        if args.op in {"set", "unset", "restore"}:
            with _mutation_lock(Path(args.file).expanduser()):
                return args.fn(args)
        return args.fn(args)
    except (OSError, ValueError, subprocess.SubprocessError):
        # Do not echo argv, subprocess stderr, document contents, or identities.
        print("envctl: operation failed; check file permissions, lock, dependencies, and encryption configuration", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
